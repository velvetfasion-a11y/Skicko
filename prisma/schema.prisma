generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String?
  createdAt    DateTime         @default(now())
  sessions     Session[]
  membership   WorkspaceMember?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MagicLink {
  id        String    @id @default(cuid())
  email     String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  senderName     String          @default("")
  replyTo        String          @default("")
  companyAddress String          @default("")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        WorkspaceMember[]
  domains        SendingDomain[]
  templates      Template[]
  contacts       Contact[]
  lists          List[]
  forms          SignupForm[]
  campaigns      Campaign[]
  apiKeys        ApiKey[]
  apiLogs        ApiLog[]
  suppressions   Suppression[]
  messages       Message[]
  events         ContactEvent[]
  webhooks       WebhookEvent[]
  idempotency    IdempotencyKey[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String    @unique
  workspaceId String
  role        String    @default("owner")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model SendingDomain {
  id               String     @id @default(cuid())
  workspaceId      String
  domain           String
  status           String     @default("pending")
  provider         String     @default("resend")
  providerDomainId String     @default("")
  recordsJson      String     @default("[]")
  detail           String     @default("")
  lastChecked      DateTime?
  createdAt        DateTime   @default(now())
  workspace        Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns        Campaign[]

  @@unique([workspaceId, domain])
}

model Template {
  id          String     @id @default(cuid())
  workspaceId String
  name        String
  description String     @default("")
  category    String     @default("marketing")
  html        String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
}

model Contact {
  id                 String              @id @default(cuid())
  workspaceId        String
  email              String
  firstName          String              @default("")
  lastName           String              @default("")
  company            String              @default("")
  properties         String              @default("{}")
  status             String              @default("pending")
  consentStatus      String              @default("unknown")
  consentedAt        DateTime?
  consentSource      String              @default("")
  consentTextVersion String              @default("")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  workspace          Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lists              ListMember[]
  recipients         CampaignRecipient[]
  events             ContactEvent[]
  confirmTokens      ConfirmToken[]

  @@unique([workspaceId, email])
  @@index([workspaceId, status])
}

model ContactEvent {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  type        String
  detail      String   @default("")
  createdAt   DateTime @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contact     Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([contactId])
}

model List {
  id          String       @id @default(cuid())
  workspaceId String
  name        String
  description String       @default("")
  createdAt   DateTime     @default(now())
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  members     ListMember[]
  forms       SignupForm[]
  campaigns   Campaign[]
}

model ListMember {
  listId    String
  contactId String
  createdAt DateTime @default(now())
  list      List     @relation(fields: [listId], references: [id], onDelete: Cascade)
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([listId, contactId])
}

model Suppression {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  reason      String
  source      String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, email])
}

model SignupForm {
  id             String    @id @default(cuid())
  workspaceId    String
  listId         String?
  name           String
  headline       String    @default("")
  description    String    @default("")
  buttonLabel    String    @default("Subscribe")
  doubleOptIn    Boolean   @default(true)
  consentText    String
  consentVersion String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list           List?     @relation(fields: [listId], references: [id], onDelete: SetNull)
}

model ConfirmToken {
  id        String    @id @default(cuid())
  contactId String
  formId    String    @default("")
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  contact   Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
}

model Campaign {
  id            String              @id @default(cuid())
  workspaceId   String
  name          String
  subject       String              @default("")
  preheader     String              @default("")
  fromName      String              @default("")
  fromLocalPart String              @default("hello")
  replyTo       String              @default("")
  domainId      String?
  templateId    String?
  listId        String?
  status        String              @default("draft")
  step          Int                 @default(1)
  testSentAt    DateTime?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  workspace     Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  domain        SendingDomain?      @relation(fields: [domainId], references: [id], onDelete: SetNull)
  template      Template?           @relation(fields: [templateId], references: [id], onDelete: SetNull)
  list          List?               @relation(fields: [listId], references: [id], onDelete: SetNull)
  recipients    CampaignRecipient[]

  @@index([workspaceId, status])
}

model CampaignRecipient {
  id         String   @id @default(cuid())
  campaignId String
  contactId  String
  status     String   @default("queued")
  messageId  String?
  error      String   @default("")
  updatedAt  DateTime @updatedAt
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([campaignId, contactId])
  @@index([campaignId, status])
}

model Message {
  id          String    @id @default(cuid())
  workspaceId String
  providerId  String?   @unique
  toEmail     String
  fromEmail   String
  subject     String
  category    String
  source      String
  campaignId  String?
  contactId   String?
  status      String    @default("sent")
  html        String    @default("")
  error       String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  prefix      String
  hash        String    @unique
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  logs        ApiLog[]
}

model ApiLog {
  id             String   @id @default(cuid())
  workspaceId    String
  apiKeyId       String?
  method         String
  path           String
  status         Int
  idempotencyKey String   @default("")
  requestBody    String   @default("")
  responseBody   String   @default("")
  createdAt      DateTime @default(now())
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  apiKey         ApiKey?  @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model IdempotencyKey {
  id           String    @id @default(cuid())
  workspaceId  String
  key          String
  requestHash  String
  statusCode   Int
  responseBody String
  createdAt    DateTime  @default(now())
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  workspaceId String
  type        String
  email       String    @default("")
  payload     String    @default("")
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
}
