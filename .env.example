# Pooled connection for the app. On Neon via Vercel this is the pooler host.
# Local Postgres has no pooler: use the same direct URL for both variables.
DATABASE_URL="postgresql://skicko:skicko@127.0.0.1:5432/skicko?schema=public"
# Direct connection for Prisma Migrate. Neon/Vercel sets DATABASE_URL_UNPOOLED.
# If you omit it, scripts fall back to DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://skicko:skicko@127.0.0.1:5432/skicko?schema=public"
AUTH_SECRET="dev-secret-change-me-skicko-local"
EMAIL_TRANSPORT="console"
DEMO_API_KEY="sk_live_demo_skicko_local_dev_key"
APP_URL="http://127.0.0.1:4317"
# RESEND_API_KEY=""
# RESEND_WEBHOOK_SECRET=""
# CRON_SECRET=""
